# Copy to deploy/.env (scripts/register-aggregator.py does it and fills the client secret).
# Every variable is AGGREGATION_LAYER_<setting>; see
# backend/src/openg2p_aggregation_layer/config.py for the full list.
# Values match a local OpenG2P docker stack. Secrets stay here, never in the
# registry catalog.

AGGREGATION_LAYER_NO_OF_WORKERS=2

# ── Registry catalog: every registry this service may query (mounted by
# docker-compose.yml from deploy/registries.yaml). Adding a registry = an entry
# there + scripts/register-aggregator.py; no code change. ──
AGGREGATION_LAYER_REGISTRY_CATALOG_PATH=/config/registries.yaml

# ── Own signing key (PM partner PARTNER_AGGREGATION_LAYER, kid agg-2026-01) ──
AGGREGATION_LAYER_SIGNING_P12_PATH=/keys/aggregation-layer.p12
AGGREGATION_LAYER_SIGNING_KID=agg-2026-01
AGGREGATION_LAYER_AGGREGATOR_ISSUER=aggregation-layer
AGGREGATION_LAYER_AGGREGATOR_SENDER_ID=aggregation-layer

# ── Consent Manager ──
AGGREGATION_LAYER_CM_BASE_URL=http://consent-manager-api:8000
AGGREGATION_LAYER_CM_TOKEN_URL=http://localhost:8080/realms/staff/protocol/openid-connect/token
AGGREGATION_LAYER_CM_CLIENT_ID=aggregation-layer
AGGREGATION_LAYER_CM_CLIENT_SECRET=

# ── Staff auth: tokens of the staff realm (staff search routes only) ──
AGGREGATION_LAYER_AUTH_ENABLED=true
AGGREGATION_LAYER_AUTH_ISSUER=http://localhost:8080/realms/staff
AGGREGATION_LAYER_AUTH_JWKS_URL=http://localhost:8080/realms/staff/protocol/openid-connect/certs
AGGREGATION_LAYER_SUBJECT_DEFAULT_ID_TYPE=national_id

# ── Staff search (POST /aggregation/v1/staff/registry/search, no consent) ──
# Staff token from the realm above, with one of these roles (JSON list).
AGGREGATION_LAYER_STAFF_SEARCH_ROLES=["AGGREGATION_STAFF_VIEWER"]
# The AL's own client for the registries' staff-apis (client_credentials);
# its service account needs Data Supervisor on each *-registry-staff-portal client.
AGGREGATION_LAYER_STAFF_API_TOKEN_URL=http://localhost:8080/realms/staff/protocol/openid-connect/token
AGGREGATION_LAYER_STAFF_API_CLIENT_ID=aggregation-layer-staff
AGGREGATION_LAYER_STAFF_API_CLIENT_SECRET=
# Staff-api metadata (tabs, sections) cache; per-registry concurrency limit (per worker).
AGGREGATION_LAYER_STAFF_API_METADATA_TTL_SEC=600
AGGREGATION_LAYER_STAFF_API_MAX_CONCURRENCY=20
AGGREGATION_LAYER_STAFF_API_QUEUE_TIMEOUT_SEC=5
# How long a searchId opens tabs; list section paging; staff requests per user per minute (0 = off).
AGGREGATION_LAYER_STAFF_SEARCH_TTL_SEC=1800
AGGREGATION_LAYER_STAFF_TAB_PAGE_SIZE=50
AGGREGATION_LAYER_STAFF_TAB_MAX_PAGE_SIZE=200
AGGREGATION_LAYER_STAFF_RATE_LIMIT_PER_MINUTE=120
# MAC key of the searchId ticket (nothing is stored). Empty = derived from the
# signing key above; every pod must end up with the same key.
AGGREGATION_LAYER_STAFF_SEARCH_TICKET_SECRET=

# Validity of each registry hop's consent object.
AGGREGATION_LAYER_AGGREGATOR_CONSENT_VALIDITY_SEC=300
# Async route: timeout of the one callback attempt (no retry).
AGGREGATION_LAYER_AGGREGATOR_CALLBACK_TIMEOUT=30
