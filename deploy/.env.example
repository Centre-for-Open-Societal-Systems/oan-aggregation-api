# Copy to deploy/.env (scripts/register-aggregator.py does it and fills the two secrets).
# Every variable is AGGREGATION_LAYER_<setting>; see
# backend/src/openg2p_aggregation_layer/config.py for the full list.
# Values match the local OpenG2P docker stack.

AGGREGATION_LAYER_NO_OF_WORKERS=2

# ── Own signing key (PM partner PARTNER_AGGREGATION_LAYER, kid agg-2026-01) ──
AGGREGATION_LAYER_SIGNING_P12_PATH=/keys/aggregation-layer.p12
AGGREGATION_LAYER_SIGNING_KID=agg-2026-01
AGGREGATION_LAYER_AGGREGATOR_ISSUER=aggregation-layer
AGGREGATION_LAYER_AGGREGATOR_SENDER_ID=aggregation-layer

# ── Consent Manager ──
AGGREGATION_LAYER_CM_BASE_URL=http://consent-manager-api:8000
AGGREGATION_LAYER_CM_TOKEN_URL=http://localhost:8080/realms/staff/protocol/openid-connect/token
AGGREGATION_LAYER_CM_CLIENT_ID=aggregation-layer
AGGREGATION_LAYER_CM_CLIENT_SECRET=
# Same value as CONSENT_MANAGER_AGGREGATION_LAYER_EVENTS_HMAC_SECRET on the CM.
AGGREGATION_LAYER_CM_EVENTS_HMAC_SECRET=
# Where the farmer approves a raised consent (CM consent UI).
AGGREGATION_LAYER_CONSENT_UI_BASE_URL=http://localhost:3002

# ── Subject-facing auth: farmer token from the staff realm, as on the CM ──
AGGREGATION_LAYER_AUTH_ENABLED=true
AGGREGATION_LAYER_AUTH_ISSUER=http://localhost:8080/realms/staff
AGGREGATION_LAYER_AUTH_JWKS_URL=http://localhost:8080/realms/staff/protocol/openid-connect/certs
AGGREGATION_LAYER_SUBJECT_DEFAULT_ID_TYPE=national_id

# ── Registries: where each lives and which CM binding to spend there ──
AGGREGATION_LAYER_AGGREGATOR_REGISTRIES={"farmer":{"url":"http://openg2p-farmer-registry-partner-api:8000","audience":"agg-layer-farmer","controller_id":"farmer_registry","reg_type":"Farmer","reg_record_type":"spdci-extensions-dci:FarmerRecord","receiver_id":"farmer-registry","id_type":"functional_id"},"livestock":{"url":"http://livestock-registry-partner-api:8000","audience":"agg-layer-livestock","controller_id":"livestock_registry","reg_type":"Livestock","reg_record_type":"spdci-extensions-dci:LivestockRecord","receiver_id":"livestock-registry","id_type":"functional_id"},"cropsown":{"url":"http://cropsown-registry-partner-api:8000","audience":"agg-layer-cropsown","controller_id":"cropsown_registry","reg_type":"CropSown","reg_record_type":"spdci-extensions-dci:CropSownRecord","receiver_id":"cropsown-registry","id_type":"functional_id"}}
AGGREGATION_LAYER_AGGREGATOR_CONSENT_VALIDITY_SEC=300

# ── OTP (dev: code in the log and on GET /consent/v1/aggregation/{id}/otp) ──
AGGREGATION_LAYER_OTP_PROVIDER=fayda
AGGREGATION_LAYER_OTP_SALT=dev-otp-salt-change-me
AGGREGATION_LAYER_OTP_DEBUG_ENABLED=true

# ── Kafka (off = in-process fan-out; see deploy/docker-compose.kafka.yml) ──
AGGREGATION_LAYER_KAFKA_ENABLED=false
AGGREGATION_LAYER_KAFKA_BOOTSTRAP_SERVERS=agg-kafka:9094
