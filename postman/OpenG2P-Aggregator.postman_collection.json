            "description": "The sync search with `registryFilter: [\"FARMER_REGISTRY\"]`: only that registry is queried and only its scopes are released.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"header\": {\n    \"version\": \"1.0.0\",\n    \"message_id\": \"{{$guid}}\",\n    \"message_ts\": \"{{$isoTimestamp}}\",\n    \"action\": \"search\",\n    \"sender_id\": \"{{partner_audience}}\",\n    \"receiver_id\": \"aggregation-layer\",\n    \"sender_uri\": \"{{callback_url}}\",\n    \"total_count\": 1,\n    \"is_msg_encrypted\": false\n  },\n  \"message\": {\n    \"transaction_id\": \"txn-{{$timestamp}}\",\n    \"search_request\": [\n      {\n        \"reference_id\": \"ref-{{$timestamp}}\",\n        \"timestamp\": \"{{$isoTimestamp}}\",\n        \"search_criteria\": {\n          \"version\": \"1.0.0\",\n          \"query_type\": \"beneficiary360\",\n          \"query\": {\n            \"@context\": \"{{bene360_context}}\",\n            \"foundationalId\": \"{{foundational_id}}\",\n            \"timeframe\": \"Timeframe-Medium\",\n            \"sections\": [\n              \"REGISTRIES\"\n            ],\n            \"registryFilter\": [\n              \"FARMER_REGISTRY\"\n            ],\n            \"correlationId\": \"postman-{{$timestamp}}\"\n          },\n          \"purpose\": {\n            \"code\": \"loan_origination\"\n          },\n          \"authorize\": {\n            \"consent_jws\": \"{{consent_jws}}\"\n          }\n        }\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answered (200)', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const res = ((j.message || {}).search_response || [{}])[0];",
                  "const rec = ((res.data || {}).reg_records || [])[0] || {};",
                  "pm.test('a signed DCI on-search', () => {",
                  "  pm.expect(j.header.action).to.eql('on-search');",
                  "  pm.expect(j.signature).to.be.a('string');",
                  "});",
                  "pm.test('reg_records[0] is a Beneficiary-360 response', () => pm.expect(rec['@type']).to.eql('Beneficiary360Response'));",
                  "const target = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "if (j.message && j.message.correlation_id) { target.set('correlation_id', j.message.correlation_id); }",
                  "pm.test('only FARMER_REGISTRY queried', () => pm.expect((rec.meta || {}).sourceSystemsQueried).to.eql(['FARMER_REGISTRY']));",
                  "console.log(JSON.stringify(rec, null, 2));"
                ]
              }
            }
          ]
